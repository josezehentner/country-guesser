{
  "name": "country-quiz",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "start": "python3 tools/serve.py",
    "start:lan": "python3 tools/serve.py --lan",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test \"tests/unit/*.test.js\"",
    "test:e2e": "playwright test",
    "build:vendor": "esbuild tools/d3-bundle.js --bundle --format=esm --minify --legal-comments=none --outfile=vendor/d3.bundle.js",
    "build:images": "node tools/mode-images.js && node tools/menu-background.js && node tools/globe-background.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "d3-geo": "3.1.1",
    "d3-selection": "3.0.0",
    "d3-zoom": "3.0.0",
    "esbuild": "0.28.2"
  }
}
